<?xml version="1.0"?>

<Glabels-templates>

  <!-- =================================================================== -->
  <!-- Generic barcode labels for thermal roll printers (Zebra, TSC,       -->
  <!-- Xprinter, Godex, ...). One label per page; width is across the     -->
  <!-- print head, height is along the feed direction.                    -->
  <!-- =================================================================== -->

  <!-- 30mm x 15mm (1.18" x 0.59") -->
  <Template brand="Barcode Labels" part="30 × 15 mm" _description="Mini / Jewelry Tag"
	    size="roll" roll_width="34mm" width="30mm" height="15mm" >
    <Meta category="label"/>
    <Meta category="barcode-label"/>
    <Meta category="rectangle-label"/>
    <Label-rectangle id="0" width="30mm" height="15mm" round="2mm" x_waste="0" y_waste="0">
      <Markup-margin x_size="1.5mm" y_size="1.5mm" /> <!-- Safe area -->
      <Layout nx="1" ny="1" x0="0" y0="0" dx="0" dy="0"/>
    </Label-rectangle>
  </Template>

